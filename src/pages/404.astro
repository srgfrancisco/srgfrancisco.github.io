---
import Base from '../layouts/Base.astro';

/*
 * GitHub Pages serves this file with a real 404 status for any unmatched path,
 * which is what the Hashnode leftovers still being crawled (`/$` and friends)
 * should get. Redirect stubs exist only for URLs with a genuine destination.
 */
---

<Base
  title="Page not found"
  description="That page does not exist on sergiofrancisco.com."
>
  <section>
    <div class="mx-auto w-full max-w-[52rem] px-6 pt-16 pb-24 sm:px-8 sm:pt-20">
      <p class="label">404</p>
      <h1 class="display mt-4 text-[30px] sm:text-[38px]">
        This page does not exist.
      </h1>
      <p class="mt-4 max-w-[56ch] text-muted">
        The link may be from an older version of this site, or it may simply be
        wrong. Nothing here is hidden — start from the home page and everything
        is one click away.
      </p>
      <p class="mt-8">
        <a href="/">Go to the home page</a>
      </p>
    </div>
  </section>
</Base>
