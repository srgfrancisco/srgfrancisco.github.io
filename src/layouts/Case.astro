---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from './Base.astro';

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  role?: string;
  deliveredVia?: string;
  years?: string;
  stack: string[];
  image?: string;
  /** Client mark, drawn beside the eyebrow. Optional, as the schema intends. */
  logo?: ImageMetadata;
}

const {
  title,
  eyebrow,
  description,
  role,
  deliveredVia,
  years,
  stack,
  image,
  logo,
} = Astro.props;

const facts = [
  years && ['Delivered', years],
  role && ['Role', role],
  deliveredVia && ['Contract', deliveredVia],
].filter(Boolean) as [string, string][];
---

<Base title={`${eyebrow} — ${title}`} description={description} image={image}>
  <article>
    <header class="border-b border-border">
      <div class="mx-auto w-full max-w-[52rem] px-6 pt-16 pb-10 sm:px-8 sm:pt-20">
        <div class="flex items-start gap-4">
          {
            /*
             * Decorative: the eyebrow prints the client name immediately
             * beside it, so a described image would announce it twice.
             */
          }
          {
            logo && (
              <Image
                src={logo}
                alt=""
                aria-hidden="true"
                width={88}
                height={88}
                class="h-11 w-11 shrink-0 border border-border object-contain p-1"
              />
            )
          }
          <div class="min-w-0">
            <p class="label">{eyebrow}</p>
            <h1 class="display mt-2 text-[30px] sm:text-[38px]">{title}</h1>
          </div>
        </div>
        <p class="mt-4 max-w-[52ch] text-muted">{description}</p>
        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
          {
            facts.map(([term, value]) => (
              <div>
                <dt class="label">{term}</dt>
                <dd class="tnum mt-1 text-[13px]">{value}</dd>
              </div>
            ))
          }
          <div class="min-w-0">
            <dt class="label">Stack</dt>
            <dd class="tnum mt-1 text-[13px] text-muted">{stack.join(' · ')}</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="mx-auto w-full max-w-[52rem] px-6 py-12 sm:px-8">
      <div class="prose">
        <slot />
      </div>
      <p class="mt-16 border-t border-border pt-6 text-[13px]">
        <a href="/#work" class="link-quiet">← All projects</a>
      </p>
    </div>
  </article>
</Base>
