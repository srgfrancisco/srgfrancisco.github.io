---
import Base from './Base.astro';
import { fullRange } from '../lib/period';

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  periodStart?: string;
  periodEnd?: string;
  meta?: string;
  stack: string[];
}

const { title, eyebrow, description, periodStart, periodEnd, meta, stack } =
  Astro.props;
const period =
  periodStart && periodEnd ? fullRange(periodStart, periodEnd) : undefined;
---

<Base title={title} description={description}>
  <article>
    <header class="border-b border-border">
      <div class="mx-auto w-full max-w-[52rem] px-6 pt-16 pb-10 sm:px-8 sm:pt-20">
        <p class="label">{eyebrow}</p>
        <h1 class="display mt-4 text-[30px] sm:text-[38px]">{title}</h1>
        <p class="mt-4 max-w-[52ch] text-muted">{description}</p>
        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
          {
            period && (
              <div>
                <dt class="label">Period</dt>
                <dd class="tnum mt-1 text-[13px]">{period}</dd>
              </div>
            )
          }
          {
            meta && (
              <div>
                <dt class="label">Context</dt>
                <dd class="mt-1 text-[13px]">{meta}</dd>
              </div>
            )
          }
          <div class="min-w-0">
            <dt class="label">Stack</dt>
            <dd class="tnum mt-1 text-[13px] text-muted">{stack.join(' · ')}</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="mx-auto w-full max-w-[52rem] px-6 py-12 sm:px-8">
      <div class="prose">
        <slot />
      </div>
      <p class="mt-16 border-t border-border pt-6 text-[13px]">
        <a
          href="/#work"
          class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-text"
          >← All work</a
        >
      </p>
    </div>
  </article>
</Base>
