---
import { site } from '../site';

const year = new Date().getFullYear();
const links = [
  { href: `mailto:${site.email}`, label: 'Email' },
  { href: site.linkedin, label: 'LinkedIn' },
  { href: site.github, label: 'GitHub' },
];
---

<footer class="mt-24 border-t border-border">
  <div
    class="mx-auto flex w-full max-w-[52rem] flex-col gap-4 px-6 py-8 text-[13px] sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p class="text-faint">
      © {year} {site.name} · {site.location} · {site.timezone}
    </p>
    <ul class="flex items-center gap-6">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-muted transition-colors hover:text-text"
              rel={link.href.startsWith('mailto:') ? undefined : 'me noopener'}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
