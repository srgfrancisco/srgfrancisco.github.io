---
import type { CollectionEntry } from 'astro:content';
import { yearRange } from '../lib/period';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;
---

<section id="work" aria-labelledby="work-heading" class="scroll-mt-8">
  <div class="mx-auto w-full max-w-[52rem] px-6 sm:px-8">
    <h2 id="work-heading" class="label pt-14">Selected work</h2>
    <ul class="mt-6 border-t border-border">
      {
        entries.map((entry) => (
          <li class="border-b border-border">
            <a
              href={`/work/${entry.id}/`}
              class="group grid grid-cols-1 gap-x-6 gap-y-1 py-5 sm:grid-cols-[6.5rem_1fr] sm:py-6"
            >
              <span class="tnum text-[12px] text-faint sm:pt-[3px]">
                {yearRange(entry.data.periodStart, entry.data.periodEnd)}
              </span>
              <span class="min-w-0">
                <span class="flex flex-wrap items-baseline gap-x-3">
                  <span class="display text-[17px] transition-colors group-hover:text-white">
                    {entry.data.company}
                  </span>
                  <span class="text-[13px] text-faint">{entry.data.role}</span>
                </span>
                <span class="mt-1 block text-muted transition-colors group-hover:text-text">
                  {entry.data.summary}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
