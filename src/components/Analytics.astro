---
/**
 * Google Analytics 4, loaded directly rather than through Google Tag Manager.
 *
 * The GTM container (GTM-WVBZF5P4) was carried over from Hashnode first, and
 * it was configured correctly — a `__googtag` tag with this Measurement ID,
 * firing on All Pages — but the property recorded nothing. This is the
 * snippet GA4 itself hands out for the data stream, and it removes the
 * container from the path so that a hit either lands or doesn't.
 *
 * Nothing else on this site needed a tag manager, so GTM is gone rather than
 * sitting alongside gtag.js, which would double every pageview.
 *
 * Production builds only — the dev server would otherwise send localhost
 * traffic to the property.
 */
import { site } from '../site';
---

{
  import.meta.env.PROD && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`} />
      {/*
       * Interpolated with set:html rather than define:vars: define:vars wraps
       * the script in an IIFE, which keeps `gtag` inside that closure. The
       * config call still runs, so pageviews go out and the breakage is
       * invisible — but nothing on the page can call gtag afterwards.
       */}
      <script
        is:inline
        set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${site.ga4Id}');`}
      />
    </>
  )
}
