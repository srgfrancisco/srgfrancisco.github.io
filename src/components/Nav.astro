---
import { site } from '../site';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Projects' },
  { href: '/skills', label: 'Skills' },
  { href: '/about', label: 'About' },
  { href: '/hire', label: 'Hire' },
];
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="border-b border-border">
  <nav
    aria-label="Primary"
    class="mx-auto flex w-full max-w-[52rem] items-center justify-between gap-6 px-6 py-5 sm:px-8"
  >
    <a href="/" class="signature text-[26px]">{site.name}</a>
    <ul class="flex items-center gap-6">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={[
                'text-[13px] transition-colors hover:text-text',
                isCurrent(link.href) ? 'text-text' : 'text-muted',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
